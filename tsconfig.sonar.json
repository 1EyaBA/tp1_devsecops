{
  "//": "Utilisé uniquement par SonarQube 9.9 (son TypeScript ne supporte pas ES2023 ni moduleResolution=bundler)",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "back",
    "paths": { "src/*": ["src/*"] }
  },
  "include": ["back/src", "front/src"]
}
